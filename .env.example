# Copy to .env.local and fill in. Restart `pnpm dev` after changes.

VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
# Contact, Register, Teacher bio
VITE_EMAILJS_TEMPLATE_ID=
# Pre-registration page (/pre-register). If unset, falls back to TEMPLATE_ID (dev only).
VITE_EMAILJS_PREREG_TEMPLATE_ID=
# Testimonials page (/testimonials)
VITE_EMAILJS_TESTIMONIAL_TEMPLATE_ID=
# Apply to teach page (/apply)
VITE_EMAILJS_APPLY_TEMPLATE_ID=

# Mailing list (server-side only, never VITE_). Resend API key with **Full access**
# (a Sending-access key can't write contacts). RESEND_SEGMENT_ID is optional.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
